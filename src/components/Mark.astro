---
// The Beadhive mark, ported from infra/brand/templates/mark-{core,glyph}.svg.
// The brand's {{LINE}}/{{GOLD}}/{{GROUND}} placeholders become CSS variables so
// one component serves both themes instead of shipping two rasterized copies.
//
// GEOMETRY IS LAW (brand suite §07): the three-cell junction vertex is pinned at
// (60,60) — the exact icon center — BEFORE rotate(30 60 60). The cluster is
// 3-fold symmetric about that point, so it stays balanced in square and circle
// crops. Do not nudge the polygons.
//
// Tiers are by rendered size, per the brand: core ≥24px, glyph ≤20px. The glyph
// relaxes exactly one rule — its bead floats centered in the cell rather than
// threaded on a wall, because at 16px bead-on-wall costs more clarity than it buys.
interface Props {
  tier?: 'core' | 'glyph';
  size?: number;
  class?: string;
}
const { tier = 'core', size = 32, class: cls = '' } = Astro.props;
// Unique clip ids — the mark appears several times per page.
const uid = Math.random().toString(36).slice(2, 9);
---
{tier === 'core' ? (
  <svg class={`bh-mark ${cls}`} width={size} height={size} viewBox="-11 -11 142 142"
       role="img" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id={`bead-${uid}`}><rect x="40" y="64" width="40" height="24" rx="11"/></clipPath>
    </defs>
    <g transform="rotate(30 60 60)">
      <g fill="none" stroke="var(--mark-line)" stroke-width="4.5" stroke-linejoin="round">
        <polygon points="60,-4 87.7,12 87.7,44 60,60 32.3,44 32.3,12"/>
        <polygon points="32.3,44 60,60 60,92 32.3,108 4.6,92 4.6,60"/>
        <polygon points="87.7,44 115.4,60 115.4,92 87.7,108 60,92 60,60"/>
      </g>
      <rect x="40" y="64" width="40" height="24" rx="11" fill="var(--honey)"/>
      <g clip-path={`url(#bead-${uid})`}>
        <rect x="36" y="71.5" width="48" height="9" fill="var(--bg)"/>
      </g>
    </g>
  </svg>
) : (
  <svg class={`bh-mark ${cls}`} width={size} height={size} viewBox="0 0 60 60"
       role="img" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id={`bead-${uid}`}><rect x="21" y="16" width="18" height="28" rx="8.5"/></clipPath>
    </defs>
    <polygon points="56,30 43,52.5 17,52.5 4,30 17,7.5 43,7.5"
             fill="none" stroke="var(--mark-line)" stroke-width="6" stroke-linejoin="round"/>
    <rect x="21" y="16" width="18" height="28" rx="8.5" fill="var(--honey)"/>
    <g clip-path={`url(#bead-${uid})`}>
      <rect x="27" y="12" width="6" height="36" fill="var(--bg)"/>
    </g>
  </svg>
)}
