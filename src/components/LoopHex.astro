---
// The factory loop as a hexagon: six phases on the vertices, six functions on
// the edges, traversed clockwise from Idea at twelve o'clock.
//
// Why a hexagon and not a circle: the ring has to close (that closure IS the
// argument), and the six-sided form ties the diagram to the honeycomb the whole
// brand is built from. Vertices are cells; the bead runs the ring.
//
// Deliberately NO `bh` commands on the edges — this sits above the fold, before
// the CLI has been introduced. Edges carry the *function being applied*, not the
// verb you would type.
//
// Geometry: pointy-top ring, vertex 0 at -90° (twelve o'clock), +60° clockwise
// per step. Screen coords, so positive angles go down.
const CX = 360, CY = 280, R = 150;
const RAD = (deg: number) => (deg * Math.PI) / 180;
const at = (deg: number, r: number) => [CX + r * Math.cos(RAD(deg)), CY + r * Math.sin(RAD(deg))];

const PHASES = [
  { key: 'idea',    label: 'Idea',       angle: -90 },
  { key: 'plan',    label: 'Plan',       angle: -30 },
  { key: 'build',   label: 'Build',      angle:  30 },
  { key: 'review',  label: 'Review',     angle:  90 },
  { key: 'integ',   label: 'Integrate',  angle: 150 },
  { key: 'prod',    label: 'Production', angle: 210 },
];

// Edge i runs PHASES[i] → PHASES[i+1]. ONE word each — the inner labels sit
// inside the ring and anything longer collides with the edge it names ("code"
// rather than "implement" for exactly that reason on the vertical right edge).
// The last edge — Production back to Idea — is the feedback edge, drawn dashed
// and gold because it is the piece missing almost everywhere, including here.
// Its name rides OUTSIDE the ring, so the one edge that matters most is the one
// label that isn't boxed in by the shape.
const EDGES = [
  { fn: 'scope' },
  { fn: 'code' },
  { fn: 'verify' },
  { fn: 'merge' },
  { fn: 'deploy' },
  { fn: 'triage', missing: true },
];

// A flat-top cell at each vertex — the brand's 30°-rotated lattice orientation,
// so the nodes read as comb cells rather than generic dots.
const cell = (x: number, y: number, r = 27) =>
  `${x - r},${y} ${x - r / 2},${y - r * 0.866} ${x + r / 2},${y - r * 0.866} ` +
  `${x + r},${y} ${x + r / 2},${y + r * 0.866} ${x - r / 2},${y + r * 0.866}`;

const nodes = PHASES.map((p) => {
  const [x, y] = at(p.angle, R);
  const [lx, ly] = at(p.angle, R + 46);
  const anchor = Math.abs(Math.cos(RAD(p.angle))) < 0.2 ? 'middle'
    : Math.cos(RAD(p.angle)) > 0 ? 'start' : 'end';
  return { ...p, x, y, lx, ly, anchor };
});

// Edge label sits just inside the ring so it can never collide with the phase
// name, which sits just outside it.
const edges = EDGES.map((e, i) => {
  const a = nodes[i], b = nodes[(i + 1) % 6];
  // Bisect the edge by angle rather than averaging the endpoints' angles —
  // the last edge wraps past -90°, and averaging would place its label
  // diametrically opposite where it belongs.
  const [lx, ly] = at(a.angle + 30, R * 0.866 - 28);
  return { ...e, x1: a.x, y1: a.y, x2: b.x, y2: b.y, lx, ly };
});

// Market segments: which CATEGORY of product owns each stretch of the ring.
// These are neutral category names, not a claim about anyone's product. The
// point they make is structural — three categories means three separate data
// stores, so nothing can see the whole ring at once — and the visible gap
// between the last arc and the first is the feedback edge nobody sells.
// Named as the AI-agent product categories now reaching market, not the
// pre-AI tools they descend from: the point is that even the *new* generation
// arrives segmented, one product per arc.
const SEGMENTS = [
  { from: -90, to: -30, l1: 'agentic planning',    l2: 'design → tasks' },
  { from: -30, to:  90, l1: 'agentic development', l2: 'frameworks' },
  { from:  90, to: 210, l1: 'SRE & DevOps',        l2: 'agents' },
];
const arc = (from: number, to: number, r: number) => {
  const [sx, sy] = at(from, r), [ex, ey] = at(to, r);
  return `M ${sx.toFixed(1)} ${sy.toFixed(1)} A ${r} ${r} 0 0 1 ${ex.toFixed(1)} ${ey.toFixed(1)}`;
};
// "feedback" sits OUTSIDE the dashed edge (edge 5, bisected at 240°), in the
// gap the segment arcs deliberately leave open — the one label with nothing
// above it, because nothing on the market covers it.
const [fbX, fbY] = at(240, R * 0.866 + 32);

const segments = SEGMENTS.map((s) => {
  const midAngle = (s.from + s.to) / 2;
  const [lx, ly] = at(midAngle, R + 96);
  const c = Math.cos(RAD(midAngle));
  return { ...s, d: arc(s.from, s.to, R + 74), lx, ly,
           anchor: Math.abs(c) < 0.2 ? 'middle' : c > 0 ? 'start' : 'end' };
});
---
<figure class="loophex">
  <div class="loophex-frame">
    <svg viewBox="0 0 720 548" role="img"
         aria-label="The factory loop drawn as a hexagon. Six phases on the vertices, clockwise from Idea at the top: Idea, Plan, Build, Review, Integrate, Production. The edges carry the function applied between them: decompose, implement, verify, merge, release and deploy, and finally feedback from Production back to Idea. The feedback edge is dashed because it is the piece not yet built. Coding agents typically cover only Plan through Review; SRE tooling covers only the production segment.">
      <defs>
        <marker id="lh-arrow" viewBox="0 0 10 10" refX="8" refY="5"
                markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--mark-line)"/>
        </marker>
        <marker id="lh-arrow-gold" viewBox="0 0 10 10" refX="8" refY="5"
                markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--honey)"/>
        </marker>
      </defs>

      {/* market segments, drawn first so the ring sits on top */}
      {segments.map((s) => (
        <>
          <path class="lh-span" d={s.d} />
          <text class="lh-span-label" x={s.lx} y={s.ly} text-anchor={s.anchor}>
            <tspan x={s.lx} dy="0">{s.l1}</tspan>
            <tspan x={s.lx} dy="13">{s.l2}</tspan>
          </text>
        </>
      ))}

      {/* the ring */}
      {edges.map((e) => (
        <line class={e.missing ? 'lh-edge is-missing' : 'lh-edge'}
              x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2}
              marker-end={e.missing ? 'url(#lh-arrow-gold)' : 'url(#lh-arrow)'} />
      ))}

      {/* edge functions, inside the ring — one word each, all one weight and
          color. `triage` is a peer of the other five: it is a real function the
          ring performs. What is missing is the EDGE it rides, and that is
          carried by the dashed line and the gold `feedback` label outside. */}
      {edges.map((e) => (
        <text class="lh-fn" x={e.lx} y={e.ly} text-anchor="middle">{e.fn}</text>
      ))}

      {/* the name of the missing edge, outside the ring in the open gap */}
      <text class="lh-feedback" x={fbX} y={fbY} text-anchor="middle">feedback</text>

      {/* vertices */}
      {nodes.map((n) => (
        <polygon class={n.key === 'prod' ? 'lh-cell is-prod' : 'lh-cell'} points={cell(n.x, n.y)} />
      ))}
      {nodes.map((n) => (
        <text class="lh-phase" x={n.lx} y={n.ly + 5} text-anchor={n.anchor}>{n.label}</text>
      ))}
    </svg>
  </div>
  <figcaption>
    Clockwise from <b>Idea</b>. Vertices are phases; edges are the function that carries you to the
    next one. The outer arcs are the agent product categories now reaching market — three of them,
    three separate data stores, none able to see the whole ring. An agent working this line
    shouldn't need six places to look. And note where the arcs stop: <b>feedback</b> is the edge no
    category sells, which is why it's dashed, and the edge Beadhive is built to close.
  </figcaption>
</figure>
