---
// Keep the field guide's own stylesheet inline in <head>, exactly as the
// original single-file page shipped it (CSS custom properties + light/dark via
// both prefers-color-scheme and :root[data-theme] overrides). `?raw` + set:html
// + is:inline means Astro emits it verbatim into the HTML rather than hoisting
// it into a bundled/scoped stylesheet.
import globalCss from '../styles/global.css?raw';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
// The site-wide title/description track whichever hero variant is active, so a
// positioning change can't leave the <title> describing the previous pitch.
import { hero } from '../copy/heroes.ts';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const {
  title = hero.siteTitle,
  description = hero.siteDescription,
  active,
} = Astro.props;

const ogImage = new URL('/og-default.png', Astro.site).href;
// Per-page, not the site root: a hardcoded '/' made every content page declare
// itself a duplicate of the homepage to search engines.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Pre-paint: apply the persisted theme before first paint (no flash of
      // wrong theme). With no stored choice, leave it to CSS prefers-color-scheme.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Match the two ground colors in global.css so the browser chrome doesn't
        flash a different shade than the page behind it. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F7F1E1" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#110D06" />
    {/* The nav's star badge fetches from api.github.com after paint; warm the
        connection so it isn't a cold DNS + TLS round trip. */}
    <link rel="preconnect" href="https://api.github.com" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Beadhive" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* Declared dimensions let Slack/Discord/iMessage reserve the card before
        the image lands, instead of reflowing the unfurl. 1280×640 is what
        brand/render.mjs emits, and is 1200×630 crop-safe. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Beadhive — from idea to production, and back." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <style is:inline set:html={globalCss}></style>
  </head>
  <body>
    <a class="skiplink display" href="#main">Skip to content</a>
    <Nav active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var btn = document.querySelector('.themetoggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var root = document.documentElement;
          var cur = root.dataset.theme;
          if (cur !== 'light' && cur !== 'dark') {
            cur = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          var next = cur === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
      })();
    </script>
    <script is:inline>
      // GitHub star count in the nav badge. Cached for an hour; on any failure
      // (rate limit, offline) the count stays hidden and the badge is just a link.
      (function () {
        var el = document.querySelector('.ghstars');
        if (!el) return;
        function fmt(n) { return n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : String(n); }
        function show(n) { el.textContent = '★ ' + fmt(n); el.hidden = false; }
        var KEY = 'gh-stars';
        try {
          var c = JSON.parse(localStorage.getItem(KEY) || 'null');
          if (c && typeof c.n === 'number' && Date.now() - c.t < 3600000) return show(c.n);
        } catch (e) {}
        fetch('https://api.github.com/repos/beadhive/beadhive')
          .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
          .then(function (d) {
            if (typeof d.stargazers_count !== 'number') return;
            show(d.stargazers_count);
            try { localStorage.setItem(KEY, JSON.stringify({ n: d.stargazers_count, t: Date.now() })); } catch (e) {}
          })
          .catch(function () {});
      })();
    </script>
  </body>
</html>
