---
import Layout from '../layouts/Layout.astro';
import Mark from '../components/Mark.astro';
import { hero } from '../copy/heroes.ts';

// Exported so /llms.txt can enumerate this page. Sourced from the hero rather
// than restated, so the homepage still has exactly one description of itself.
export const meta = {
  order: 1,
  label: 'Home',
  title: hero.siteTitle,
  description: hero.siteDescription,
};

// --- matched-lanes diagram (#why) ---------------------------------------
// Two conveyor lanes, identical pitch. The sameness IS the argument: process
// keeps pace with code instead of braking it. Honey "beat" chevrons sit at the
// same x in both lanes, tied by dashed verticals — a shared metronome.
const LANE_X = 48, LANE_W = 404, LANE_H = 44;
const LANES = [
  { label: 'code',    y: 100 },
  { label: 'process', y: 216 },
];
const CHEV_XS = Array.from({ length: 10 }, (_, i) => 64 + i * 40);
const BEATS = [184, 384];            // honey beat chevrons — same x in both lanes
const TIES = BEATS.map((x) => x + 7); // dashed tempo ties between the lanes
// process-lane phases: zones the flow passes through, not stops along it —
// so the boundaries are ruler ticks under the lane, never walls across it.
const PHASES_LANE = ['planning', 'review', 'release', 'ops'];
const SEG = LANE_W / PHASES_LANE.length;
const chev = (x: number, laneY: number) => {
  const cy = laneY + LANE_H / 2;
  return `M ${x} ${cy - 12} L ${x + 14} ${cy} L ${x} ${cy + 12}`;
};
---
<Layout active="home">

<header>
  <div class="wrap">
    <Mark tier="core" size={54} class="hero-mark" />
    <div class="brandline display">{hero.eyebrow}</div>
    <h1 class="display">{hero.title}</h1>
    <p class="lede">{hero.lede}</p>
    <div class="herobar">
      <a class="btn btn-primary" href="/start/">Ship something real</a>
      <a class="btn btn-ghost" href="/process/">See how the factory works</a>
    </div>
  </div>
</header>

<section id="why" class="reveal">
  <div class="wrap">
    <div class="eyebrow display">The problem</div>
    <div class="why-grid">
      <div class="why-copy">
        <h2 class="display">Slop is a process problem, not an AI problem</h2>
        <p class="lede-sm">Unmaintainable software existed long before agents — AI just multiplied
        the speed it happens at. And process-as-brakes never worked either: discipline that slows
        builders down gets routed around. The answer isn't slowing anything down — it's speeding
        everything else up to match, the self-correcting practices of a mature engineering org run
        by agents at the same speed the code gets written:</p>
        <ul class="bullets">
          <li>Reviews that change the process, not just the code</li>
          <li>Incidents that become guardrails, not just fixes</li>
          <li>Retros that rewrite the next plan</li>
        </ul>
        <p class="lede-sm">Agents do the discipline. You hold the gates.</p>
      </div>
      {/* The matched-lanes diagram: two conveyor lanes at identical pitch.
          Process isn't a brake on code — it's a second lane running at the
          same cadence. Geometry lives in the frontmatter above. */}
      <div class="why-art" role="img"
           aria-label="Diagram: two conveyor lanes moving at the same speed — a code lane, and a process lane passing through planning, review, release and ops. Matching tempo marks tie the lanes together: process keeps pace with code instead of braking it.">
        <svg viewBox="24 64 452 240" aria-hidden="true">
          {/* the two tracks */}
          {LANES.map((lane) => (
            <>
              <text class="wa-lane" x={LANE_X} y={lane.y - 12}>{lane.label}</text>
              <rect x={LANE_X} y={lane.y} width={LANE_W} height={LANE_H} rx="22"
                    fill="var(--honey-wash)" opacity=".45"/>
              <rect x={LANE_X} y={lane.y} width={LANE_W} height={LANE_H} rx="22"
                    fill="none" stroke="var(--mark-line)" stroke-width="2" opacity=".5"/>
              {CHEV_XS.map((x) => (
                <path d={chev(x, lane.y)} fill="none"
                      stroke={BEATS.includes(x) ? 'var(--honey)' : 'var(--mark-line)'}
                      stroke-width={BEATS.includes(x) ? 3 : 2.5}
                      opacity={BEATS.includes(x) ? 1 : 0.4}
                      stroke-linecap="round" stroke-linejoin="round"/>
              ))}
            </>
          ))}

          {/* the tempo ties: same beat, both lanes */}
          {TIES.map((x) => (
            <line x1={x} y1={LANES[0].y + LANE_H + 4} x2={x} y2={LANES[1].y - 4}
                  stroke="var(--honey)" stroke-width="2" stroke-dasharray="2 6"
                  stroke-linecap="round" opacity=".9"/>
          ))}
          <text class="wa-pace" x={(TIES[0] + TIES[1]) / 2}
                y={(LANES[0].y + LANE_H + LANES[1].y) / 2 + 4}
                text-anchor="middle">same cadence</text>

          {/* phase ruler under the process lane — zones, not walls */}
          {PHASES_LANE.slice(1).map((_, i) => (
            <line x1={LANE_X + SEG * (i + 1)} y1={LANES[1].y + LANE_H}
                  x2={LANE_X + SEG * (i + 1)} y2={LANES[1].y + LANE_H + 8}
                  stroke="var(--mark-line)" stroke-width="1.5" opacity=".4"/>
          ))}
          {PHASES_LANE.map((p, i) => (
            <text class="wa-phase" x={LANE_X + SEG * i + SEG / 2}
                  y={LANES[1].y + LANE_H + 26} text-anchor="middle">{p}</text>
          ))}
        </svg>
      </div>
    </div>
  </div>
</section>

<div class="band">
<section id="different">
  <div class="wrap">
    <div class="eyebrow display">What's different</div>
    <h2 class="display">Three things, briefly</h2>

    <div class="featrow reveal">
      <div class="featrow-art">
        <svg viewBox="0 0 100 76" aria-hidden="true">
          <rect x="6" y="8" width="88" height="12" rx="6" fill="none" stroke="var(--mark-line)" stroke-width="2" opacity=".5"/>
          <rect x="6" y="8" width="26" height="12" rx="6" fill="var(--honey)"/>
          <rect x="6" y="32" width="88" height="12" rx="6" fill="none" stroke="var(--mark-line)" stroke-width="2" opacity=".5"/>
          <rect x="6" y="32" width="55" height="12" rx="6" fill="var(--honey)"/>
          <rect x="6" y="56" width="88" height="12" rx="6" fill="none" stroke="var(--mark-line)" stroke-width="2" opacity=".5"/>
          <rect x="6" y="56" width="80" height="12" rx="6" fill="var(--honey)"/>
        </svg>
      </div>
      <div>
        <h3>Automation is a dial, not a prerequisite</h3>
        <p>Other factories assume you already have the test coverage, the observability, and the
        trust to let agents run. Most teams have none of the three, so adoption dies on contact.</p>
        <ul class="bullets">
          <li>Zero footprint in your repo until you ask for it</li>
          <li>Every gate defaults to a human</li>
          <li>Hand over one seat at a time, when the evidence earns it</li>
        </ul>
        <a class="deeplink" href="/roles/">See the seats and who holds what</a>
      </div>
    </div>

    <div class="featrow reveal">
      <div class="featrow-art">
        <svg viewBox="0 0 100 76" aria-hidden="true">
          <circle cx="30" cy="38" r="20" fill="none" stroke="var(--mark-line)" stroke-width="2" opacity=".55"/>
          <circle cx="70" cy="38" r="20" fill="none" stroke="var(--honey)" stroke-width="2.4"/>
          <path d="M50 20 a20 20 0 0 1 0 36 a20 20 0 0 1 0 -36" fill="var(--honey)" opacity=".18"/>
          <text x="30" y="42" text-anchor="middle" font-size="9" fill="var(--ink-3)" font-family="monospace">code</text>
          <text x="70" y="42" text-anchor="middle" font-size="9" fill="var(--ink-3)" font-family="monospace">ops</text>
        </svg>
      </div>
      <div>
        <h3>The coding framework and the SRE agent are one system</h3>
        <p>Built as two products everywhere else — one writes code, another watches it run,
        nothing connects them. An incident shouldn't just get mitigated once; it should change
        what gets generated next time.</p>
        <ul class="bullets">
          <li>Reviews target the process, not just the incident — the output is a guardrail that
          prevents recurrence, not only a fix</li>
          <li>Shipped: planning, dispatch, review, merge, release ordering</li>
          <li>Building: the return path — prod signal into plans and guardrails</li>
        </ul>
        <a class="deeplink" href="/process/">Follow a change through the line</a>
      </div>
    </div>

    <div class="featrow reveal">
      <div class="featrow-art">
        <svg viewBox="0 0 100 76" aria-hidden="true">
          <polygon points="50,6 78,22 78,54 50,70 22,54 22,22" fill="none" stroke="var(--mark-line)" stroke-width="2.4"/>
          <path d="M50 6 L50 70 M22 22 L78 54 M78 22 L22 54" stroke="var(--honey)" stroke-width="1.4" opacity=".6"/>
          <circle cx="50" cy="38" r="7" fill="var(--honey)"/>
        </svg>
      </div>
      <div>
        <h3>Open source, and made to be taken apart</h3>
        <p>Developers don't adopt infrastructure they can't read. Run the whole factory on a hobby
        project over a weekend and decide for yourself whether it's real.</p>
        <ul class="bullets">
          <li>No server, no signup, no hosted dependency</li>
        </ul>
        <a class="deeplink" href="https://github.com/beadhive/beadhive">Read the source</a>
      </div>
    </div>
  </div>
</section>
</div>

<section id="how">
  <div class="wrap">
    <div class="eyebrow display">How it works</div>
    <h2 class="display">The parts you actually touch</h2>
    <p class="lede-sm"><code>bh</code> is a CLI. It drives <code>bd</code> for issues and
    <code>git</code> for history — nothing to deploy, no database to run.</p>
    <div class="bento reveal-stagger">
      <div class="card">
        <span class="kicker">substrate</span>
        <h3><span class="hexdot">⬢</span>Work is a graph</h3>
        <p>A git-embedded tracker with real dependency edges, so "what's next" is computed, and it
        survives an agent losing its context.</p>
      </div>
      <div class="card">
        <span class="kicker">roles</span>
        <h3><span class="hexdot">⬢</span>Seats, not workflows</h3>
        <p>Planner, dispatcher, developer, reviewer, merger, warden. A person or an agent fills
        any of them.</p>
      </div>
      <div class="card">
        <span class="kicker">control</span>
        <h3><span class="hexdot">⬢</span>Humans hold the gates</h3>
        <p>Gates are records, not vibes in a chat log. Merge refuses to land while one is open.</p>
      </div>
      <div class="card">
        <span class="kicker">provenance</span>
        <h3><span class="hexdot">⬢</span>Every change is signed</h3>
        <p>Each agent works in its own worktree under its own identity. You can always see which
        worker did what.</p>
      </div>
    </div>
    <a class="deeplink" href="/beads/">Why a dependency graph beats a task list</a>
  </div>
</section>

<div class="band">
<section id="try">
  <div class="wrap">
    <div class="eyebrow display">Try it</div>
    <h2 class="display">Start automating one step at a time</h2>
    <p class="lede-sm">Point it at a real repo. A hive writes nothing into yours until you ask
    it to, and you don't have to run the whole ring to get something out of it.</p>
    <div class="term reveal" style="margin-top:18px">
      <div class="term-bar"><span class="term-dot"></span>bh — zsh</div>
<pre><code><span class="p">$</span> uv tool install 'beadhive[otel]'
<span class="p">$</span> bh config init
<span class="p">$</span> bh hive onboard          <span class="c"># zero footprint by default</span>
<span class="p">$</span> bh work ready            <span class="c"># what's actionable, in order</span></code></pre>
    </div>

    <p>From there, the agents take it: a planner turns your idea into a gated plan, a
    dispatcher delivers it bead by bead, and every gate defaults to you. The start guide walks
    the whole first loop — including bringing in the planning your repo already has.</p>
    <div class="herobar">
      <a class="btn btn-primary" href="/start/">The full start guide</a>
      <a class="btn btn-ghost" href="https://github.com/beadhive/beadhive/blob/main/INSTALL.md">Install reference</a>
    </div>
  </div>
</section>
</div>

<section class="teasers">
  <div class="wrap">
    <div class="eyebrow display">Go deeper</div>
    <h2 class="display">The field guide</h2>
    <p class="lede-sm">For the reader who has run these processes at scale and doubts agents
    can: this is how they're encoded. Every claim on this page has its machinery documented
    here — and the source is one link further.</p>
    <div class="cardgrid reveal-stagger">
      <a class="card teaser" href="/beads/">
        <h3><span class="hexdot">⬢</span>The substrate</h3>
        <p>Why a git-embedded, dependency-linked tracker is the right memory for agents.</p>
        <span class="cardcta display">Read Beads →</span>
      </a>
      <a class="card teaser" href="/process/">
        <h3><span class="hexdot">⬢</span>How work flows</h3>
        <p>Worktree → implement → review → merge, with the plan, kickoff and review gates.</p>
        <span class="cardcta display">Read Process →</span>
      </a>
      <a class="card teaser" href="/roles/">
        <h3><span class="hexdot">⬢</span>Who does what</h3>
        <p>Four planes, their seats, blast radius — and the harnesses a seat runs under.</p>
        <span class="cardcta display">Read Roles →</span>
      </a>
      <a class="card teaser" href="/fleet/">
        <h3><span class="hexdot">⬢</span>Scale</h3>
        <p>A fleet of hives, one Head Office, and what's actionable anywhere.</p>
        <span class="cardcta display">Read Fleet →</span>
      </a>
      <a class="card teaser" href="/data/">
        <h3><span class="hexdot">⬢</span>The ladder</h3>
        <p>Why the tracker, the docs, the reviews and the telemetry move into the graph — one
        rung at a time, each paying for itself.</p>
        <span class="cardcta display">Read The ladder →</span>
      </a>
    </div>
  </div>
</section>

</Layout>

<style>
  /* Art slot: invisible on a stacked layout (the copy carries the argument
     there), a sized right column on a laptop. */
  .why-art { display: none; }

  .why-art text {
    font-family: "JetBrains Mono", ui-monospace, Menlo, monospace;
    font-weight: 600;
  }
  .wa-lane  { fill: var(--ink-3); font-size: 13px; }
  .wa-phase { fill: var(--ink-3); font-size: 12px; }
  .wa-pace  { fill: var(--honey-strong); font-size: 12px; }

  @media (min-width: 1024px) {
    #why > .wrap { max-width: 72rem; }
    .why-grid {
      display: grid;
      grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
      column-gap: 4rem;
      align-items: stretch;
      margin-top: 6px;
    }
    .why-copy > p:last-child { margin-bottom: 0; }
    .why-art {
      display: grid;
      place-items: center;
      min-height: 22rem;
      background: var(--panel);
      border: 1px solid var(--hairline);
      border-radius: 16px;
      box-shadow: var(--shadow);
    }
    .why-art svg { display: block; width: 94%; max-width: 30rem; height: auto; }
  }
</style>
