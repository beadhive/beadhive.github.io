<Layout active="process" title={meta.title} description={meta.description}>
<style is:global>
  /* four-plane strip */
  .planestrip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin: 18px 0 8px; }
  .planestrip-control, .planestrip-assure {
    grid-column: 1 / -1; padding: 8px 12px; border: 1px dashed var(--hairline); border-radius: 8px;
    font-size: 12.5px; color: var(--ink-3);
  }
  .planestrip-control span, .planestrip-assure span {
    font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .12em;
    color: var(--honey-strong); margin-right: 8px;
  }
  .planestrip-assure { border-style: solid; border-color: color-mix(in srgb, var(--honey) 40%, transparent); background: var(--lane); }
  .planestrip-plane {
    position: relative; display: grid; gap: 4px; align-content: start; padding: 12px 14px;
    background: var(--panel); border: 1px solid var(--hairline); border-radius: 10px;
    text-decoration: none; color: inherit; box-shadow: var(--shadow);
  }
  .planestrip-plane:hover { border-color: var(--honey); }
  .planestrip-plane b { font-family: "Futura","Avenir Next",system-ui,sans-serif; font-size: 15px; }
  .planestrip-plane small { color: var(--ink-3); font-size: 12px; }
  .planestrip-plane .status { justify-self: start; margin-top: 6px; white-space: normal; line-height: 1.4; }
  .planestrip-plane.is-direction { border-style: dashed; }
  .planestrip-plane:not(:last-of-type)::after {
    content: "→"; position: absolute; right: -12px; top: 14px; color: var(--honey-strong); font-weight: 700;
  }
  @media (max-width: 719.98px) {
    .planestrip { grid-template-columns: 1fr 1fr; }
    .planestrip-plane::after { display: none; }
  }
  /* guarded bump */
  .bumpflow { list-style: none; padding: 0; margin: 14px 0 16px; display: grid; gap: 8px; max-width: none; }
  .bumpflow li {
    display: grid; grid-template-columns: 7rem 1fr; gap: 12px; align-items: baseline;
    padding: 9px 14px; background: var(--panel); border: 1px solid var(--hairline); border-radius: 8px;
  }
  .bumpflow li b { font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; font-size: 13px; color: var(--honey-strong); }
  .bumpflow li span { font-size: 14px; color: var(--ink-2); }
  .bumpflow li.is-green { border-color: color-mix(in srgb, var(--green) 50%, transparent); background: var(--green-wash); }
  .bumpflow li.is-green b { color: var(--green); }
  @media (max-width: 479.98px) { .bumpflow li { grid-template-columns: 1fr; gap: 2px; } }
</style>
