---
import Layout from '../layouts/Layout.astro';
import LoopHex from '../components/LoopHex.astro';

// Exported so /llms.txt can enumerate this page without a second copy of its
// title and description. A new page with a `meta` export appears there for free.
export const meta = {
  order: 4,
  label: 'How work flows',
  title: 'How work flows · Beadhive',
  description: 'The Beadhive mental model in one breath and the full planning → dispatch → develop → review → merge pipeline, with its spike, bounce, and replan loops.',
};
