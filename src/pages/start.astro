---
import Layout from '../layouts/Layout.astro';
import { installTerminalHtml, installMoreHref, installMoreLabel } from '../copy/install';

// Exported so /llms.txt can enumerate this page without a second copy of its
// title and description. A new page with a `meta` export appears there for free.
//
// Register (infra/docs/design/gtm-dual-icp.md): this page is ICP-1-voiced end
// to end — what the agents will do FOR you, never process doctrine. Indict the
// situation, not the reader; no org-chart vocabulary without an inline gloss.
//
// This page is where the site's COLLAPSE-THE-SECONDARY-AUDIENCE pattern is
// first applied ("Manual install", below). The pattern itself, and what it is
// and is not for, is written down with the rest of the copy register in
// src/copy/heroes.ts — read it before collapsing anything on a new surface.
//
// THE DESCRIPTION IS THE ONLY WAY A SECTION OF THIS PAGE REACHES /llms.txt.
// That file indexes PAGES — it reads the `meta` below, never the body — so the
// step 06 ladder ("How far it goes") is represented to agents by this sentence
// or not at all. It is also why the description had to change with bh-infra-9ne:
// it promised "install in five minutes" and a command block that step 01 no
// longer leads with, and said nothing about reach. Both halves of the page now
// answer here in the order the page answers them: how you get set up, then how
// far the same setup goes. Rung 4 stays an OUTCOME ("keeps working while you
// sleep") — the mechanism behind it is doctrine and is forbidden on this page,
// in this description, and in /llms.txt alike.
export const meta = {
  order: 2,
  label: 'Start',
  title: 'Start · Beadhive',
  description:
    'From an idea to something real: paste one link at your agent and it sets Beadhive up ' +
    'for you, the agents run the engineering process, and you hold only the decisions that ' +
    'matter — plus how far it reaches, from one laptop to a machine that keeps working ' +
    'while you sleep. No engineering-org experience required.',
};

// --- first-loop mini-ring -------------------------------------------------
// LoopHex's little sibling (see components/LoopHex.astro for the full-size
// diagram on /process). Same pointy-top geometry, ICP-1 vocabulary: idea →
// plan → build → review → ship → learn. The one honey edge is learn → idea —
// what you learn feeds the next plan, which is the whole reason to run a loop
// rather than a line. Solid, not dashed: on /start it's a promise, not a gap.
const CX = 170, CY = 156, R = 104, CELL_R = 14;
const RAD = (deg: number) => (deg * Math.PI) / 180;
const at = (deg: number, r: number): [number, number] =>
  [CX + r * Math.cos(RAD(deg)), CY + r * Math.sin(RAD(deg))];
const LOOP = ['idea', 'plan', 'build', 'review', 'ship', 'learn'].map((label, i) => {
  const angle = -90 + i * 60;
  const [x, y] = at(angle, R);
  const [lx, ly] = at(angle, R + 30);
  const c = Math.cos(RAD(angle));
  return { label, x, y, lx, ly,
           anchor: Math.abs(c) < 0.2 ? 'middle' : c > 0 ? 'start' : 'end' };
});
// flat-top comb cell at each vertex — the brand's lattice orientation
const cell = (x: number, y: number, r = CELL_R) =>
  `${x - r},${y} ${x - r / 2},${y - r * 0.866} ${x + r / 2},${y - r * 0.866} ` +
  `${x + r},${y} ${x + r / 2},${y + r * 0.866} ${x - r / 2},${y + r * 0.866}`;
// edges trimmed at both ends so the arrowheads clear the cells
const loopEdges = LOOP.map((a, i) => {
  const b = LOOP[(i + 1) % 6];
  const [dx, dy] = [b.x - a.x, b.y - a.y];
  const len = Math.hypot(dx, dy);
  const [ux, uy] = [dx / len, dy / len];
  return { closing: i === 5,
    x1: a.x + ux * (CELL_R + 3), y1: a.y + uy * (CELL_R + 3),
    x2: b.x - ux * (CELL_R + 9), y2: b.y - uy * (CELL_R + 9) };
});
// annotation beside the closing edge (its midpoint sits at 240°, upper-left)
const [npX, npY] = at(240, R + 28);
---
<Layout active="start" title={meta.title} description={meta.description}>

<section id="start" class="step">
  <div class="wrap">
    <div class="eyebrow display">Start here</div>
    <div class="intro-grid">
      <div class="intro-copy">
        <h2 class="display">You bring the idea.<br class="herobr" /> The factory brings the discipline.</h2>
        <p class="lede-sm">You don't need to know what a decision record is or why review gates
        exist. The agents run that process for you — and explain why as it happens. You decide
        what to build, and approve what ships.</p>
      </div>
      <figure class="miniloop" role="img"
              aria-label="Your first loop: from idea to plan to build to review to ship to learn — and what you learn feeds the next plan.">
        <svg viewBox="0 0 340 312" aria-hidden="true">
          <defs>
            <marker id="ml-arrow" viewBox="0 0 10 10" refX="8" refY="5"
                    markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="var(--mark-line)"/>
            </marker>
            <marker id="ml-arrow-gold" viewBox="0 0 10 10" refX="8" refY="5"
                    markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="var(--honey)"/>
            </marker>
          </defs>
          {loopEdges.map((e) => (
            <line class={e.closing ? 'ml-edge is-closing' : 'ml-edge'}
                  x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2}
                  marker-end={e.closing ? 'url(#ml-arrow-gold)' : 'url(#ml-arrow)'} />
          ))}
          {LOOP.map((n) => (
            <polygon class={n.label === 'idea' ? 'ml-cell is-next' : 'ml-cell'}
                     points={cell(n.x, n.y)} />
          ))}
          {LOOP.map((n) => (
            <text class="ml-label" x={n.lx} y={n.ly + 4} text-anchor={n.anchor}>{n.label}</text>
          ))}
          <text class="ml-note" x={npX} y={npY} text-anchor="end">
            <tspan x={npX} dy="0">feeds the</tspan>
            <tspan x={npX} dy="13">next plan</tspan>
          </text>
        </svg>
      </figure>
    </div>
  </div>
</section>

<div class="band">
<section id="install" class="step">
  <div class="wrap">
    <div class="eyebrow display"><span class="stepno">01</span><span>Five minutes</span></div>
    <div class="step-grid">
      <div class="step-text">
        <h2 class="display">A running factory, against the repo you already have</h2>
        <p class="lede-sm">No server, no signup, no hosted dependency — and nothing written into
        your repo until you ask for it.</p>
      </div>
      <div class="step-side">
        {/* THE CTA IS THE MESSAGE, and it is the whole default surface. The brief
            here is "explain how easy setup is", and the easiest TRUE statement
            about installing this is not a shell command at all — it is that you
            paste one URL at an agent and answer questions. A nix installer
            one-liner does not read as easy however it is framed, so it lives one
            click away rather than in the spotlight. Do not promote it back up. */}
        <div class="pastecard reveal">
          <p class="paste-lede">Paste one link at your agent. It asks before every command and
          tells you what each one does.</p>
          <a class="pastelink" href="https://github.com/beadhive/beadhive/blob/main/INSTALL.md"
             >https://github.com/beadhive/beadhive/blob/main/INSTALL.md</a>
        </div>
        {/* THE ONLY COMMAND BLOCK ON THIS SITE, AND IT IS A COPY. SOURCE OF
            TRUTH: beadhive/beadhive INSTALL.md — its `install:` frontmatter
            owns `methods[0].command` (the two managed-path lines), and its
            "Managed path (recommended)" prose owns the nix installer above them
            and the `bh --version` check below. Changing what this site tells
            people to run means changing INSTALL.md; this block only follows it.

            THE COMMANDS THEMSELVES NOW LIVE IN src/copy/install.ts, because
            /llms.txt has to carry them too (bh-infra-9ne.6): that file is the
            index agents read, it is generated from page `meta` and never from
            page bodies, so nothing inside this disclosure reached it. Two
            audiences want opposite defaults — collapsed for a reader, spelled
            out for an agent — and the way to serve both without a second copy
            is one data module rendered twice. This element renders it; do not
            re-inline the commands here.

            This epic exists because three surfaces each kept their own copy and
            two rotted through a full minor release — INSTALL.md moved to the
            managed path at v0.8.0 and neither the README nor this page followed
            for three releases. Adding a fourth copy anywhere restarts that clock.

            "ONE COMMAND BLOCK" MEANS ONE INSTALL BLOCK — stated so the next
            reader does not have to guess. The .term blocks further down this
            page (`bh role planner`, `bh role dispatcher`, `/bh:backfill`) stay:
            they illustrate what a seat is called, they have no source of truth
            in another repo, and there is therefore nothing for them to drift
            AGAINST. The rule is about copies of an install route, which is the
            only thing that rotted. Verified by grep across src/ and dist/ —
            `uv tool install|nix profile|pipx|pip install|brew install|docker
            run|install.determinate` matches ONE file under src/ (copy/install.ts)
            and two built artifacts (this page and /llms.txt, both rendered from
            it); the homepage's copy was removed with this change and carries a
            comment saying why. Two rendered surfaces are not two copies — one
            edit still moves both. Two source literals would be.

            WHAT GUARDS THE DEEP LINK, because it is not here and cannot be:
            GitHub derives heading anchors from heading TEXT, so renaming
            README.md's `## Install` would 404 the link below to the top of the
            file with no error this repo's CI could ever see. The guard lives on
            the side that owns the heading —
            beadhive/beadhive tests/test_readme_install_drift.py, which asserts
            that anchor still exists PRECISELY BECAUSE this page deep-links it.
            Do not reimplement that check here: nothing in this repo can read
            that one, and a second, worse copy of the guard is the same disease
            as a second copy of the commands. Same shape as astro.config.mjs,
            where the site value names tofu/porkbun_dns.tf as where the domain
            is actually configured. */}
        <details class="disclose">
          <summary>Manual install</summary>
          <div class="disclose-body">
            <div class="term">
              <div class="term-bar"><span class="term-dot"></span>bh — zsh</div>
              {/* set:html, not a template loop: this is a <pre>, so every
                  newline and the gap before `# must print…` is content, and
                  the renderer emits those bytes exactly. It also leaves the
                  apostrophes in 'beadhive[otel]' as apostrophes — an expression
                  would escape them, and an agent grepping the served HTML for
                  the command it was told to run would miss it. The `.p` / `.c`
                  spans it emits are coloured by global.css, so they need no
                  scoped-style attribute. */}
              <pre><code set:html={installTerminalHtml()} /></pre>
            </div>
            <a class="deeplink" href={installMoreHref}>{installMoreLabel}</a>
          </div>
        </details>
      </div>
    </div>
  </div>
</section>
</div>

<section id="plan" class="step step--flip">
  <div class="wrap">
    <div class="eyebrow display"><span class="stepno">02</span><span>First loop</span></div>
    <div class="step-grid">
      <div class="step-text">
        <h2 class="display">Turn the idea into a plan — by answering questions</h2>
        <p>Tell the planner what you want to build. It interviews you, researches what exists,
        writes the decisions down, and breaks the work into small, dependency-ordered pieces —
        <b>beads</b> — each sized so an agent can finish it and you can judge it.</p>
      </div>
      <div class="step-side">
        <div class="term">
<pre><code><span class="p">$</span> bh role planner            <span class="c"># an idea in, a gated plan out</span>
<span class="c"># decisions go on record — cite, don't re-decide</span></code></pre>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="build" class="step">
  <div class="wrap">
    <div class="eyebrow display"><span class="stepno">03</span><span>Then</span></div>
    <div class="step-grid">
      <div class="step-text">
        <h2 class="display">Watch it build — and hold the gates</h2>
        <p>The dispatcher hands each bead to a developer agent in its own isolated copy of the
        repo, under its own signed identity. Work comes back as a reviewable change, checks
        already run. Nothing merges while a gate is open — and <b>every gate defaults to
        you</b>.</p>
      </div>
      <div class="step-side">
        <div class="term">
<pre><code><span class="p">$</span> bh role dispatcher         <span class="c"># deliver the plan, bead by bead</span></code></pre>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="band">
<section id="bring" class="step step--flip">
  <div class="wrap">
    <div class="eyebrow display"><span class="stepno">04</span><span>Already started?</span></div>
    <div class="step-grid">
      <div class="step-text">
        <h2 class="display">Bring the planning you already have</h2>
        <p>Most repos already hold planning: decision records, design notes, a
        <code>.planning/</code> directory. Good information in the wrong format — an agent can read a file tree, but it
        can't ask what's blocked or what's ready. <b>Backfill</b> proposes that history and those
        documents as beads, and every proposal stops for you to confirm, reclassify, or throw
        away.</p>
      </div>
      <div class="step-side">
        <div class="term">
<pre><code><span class="p">$</span> bh hive onboard --claude   <span class="c"># or --opencode</span>
<span class="p">$</span> claude
<span class="p">&gt;</span> /bh:backfill               <span class="c"># propose history + docs as beads</span>
<span class="c"># reconciled, never blind-imported</span></code></pre>
        </div>
      </div>
    </div>
  </div>
</section>
</div>

<section id="pace" class="step step--top">
  <div class="wrap">
    <div class="eyebrow display"><span class="stepno">05</span><span>Your pace</span></div>
    <div class="step-grid">
      <div class="step-text">
        <h2 class="display">Take as much of the ring as you want</h2>
        <p>Nobody adopts a lifecycle in one go. Plenty of reasonable places to stop:</p>
      </div>
      <div class="step-side">
        <div class="sidecard">
          <ul class="bullets">
            <li>Start at <b>idea → plan → build</b> alone — keep reviewing, releasing and
            operating exactly as you do today</li>
            <li>Add review and merge when doing them by hand becomes the bottleneck</li>
            <li>Close the rest when — and only when — your own evidence says it's worth it</li>
          </ul>
        </div>
      </div>
    </div>
    <p class="step-closer">Every seat you haven't handed over is simply a seat a person still
    holds. That is the normal state, not a degraded one.</p>
  </div>
</section>

{/* "Your pace" above answers HOW MUCH of the loop you hand over. This answers
    HOW FAR it reaches — the question the site did not address at all, and the
    one a reader who has got rung 1 working asks next.

    PARAPHRASED FROM docs/ADOPTION.md IN THIS PAGE'S OWN VOICE — never copied.
    Same four, same order, so a reader who follows a link lands on something
    that matches what they just read. But this page's register (see the header
    comment) is outcomes, not configurations: the mechanism behind rung 4 is
    exactly the doctrine vocabulary the register forbids, so it is one honest
    sentence and a link. If you are tempted to name the machinery here, that is
    the signal to link harder, not to explain.

    THE COSTS ARE NOT OPTIONAL. "Nothing to sign up for" is only credible next
    to "nothing is backed up". The measured figures and the platform limits stay
    in the docs on purpose — this page says what it costs you, not what it costs
    in gigabytes.

    Each rung links to docs/ADOPTION.md with NO #anchor. Only README.md#install
    is drift-gated from the other side (beadhive's tests/test_readme_install_drift.py);
    an anchor into this document would be an unguarded cross-repo link that
    404s to the top of the page the day someone rewords a heading. */}
<section id="reach" class="step">
  <div class="wrap">
    <div class="eyebrow display"><span class="stepno">06</span><span>How far it goes</span></div>
    <h2 class="display">It doesn't stop at your laptop</h2>
    <p class="lede-sm">Four places people settle, and what each one really costs. It isn't a
    staircase — the third is about what's installed rather than how far you've gone, and only
    the fourth needs another rung under it first.</p>
    <ol class="runglist">
      <li class="rungrow">
        <span class="rungno"><svg viewBox="0 0 30 34" aria-hidden="true"><polygon points="15,2 28,9.5 28,24.5 15,32 2,24.5 2,9.5"/></svg><span>1</span></span>
        <div class="rungbody">
          <h3>One repo, on the laptop you already have</h3>
          <p>The whole loop, idea to shipped, against one project. Nothing to run, nothing to
          sign up for, and nothing held back for a later rung.</p>
          <p class="rungcost"><b>What it costs:</b> this machine is the only copy. Nothing is
          backed up anywhere, and nothing else can join in yet.</p>
          <a class="deeplink" href="https://github.com/beadhive/beadhive/blob/main/docs/ADOPTION.md">Starting here</a>
        </div>
      </li>
      <li class="rungrow">
        <span class="rungno"><svg viewBox="0 0 30 34" aria-hidden="true"><polygon points="15,2 28,9.5 28,24.5 15,32 2,24.5 2,9.5"/></svg><span>2</span></span>
        <div class="rungbody">
          <h3>Backed up — and more than one project</h3>
          <p>Give the factory somewhere of its own to push to and what it knows outlives the
          laptop. That's also where a second and third repo start paying off: one list of
          what's actionable, across all of them.</p>
          <p class="rungcost"><b>What it costs:</b> one private repo to hold it, and the push is
          yours to make — it doesn't happen on its own.</p>
          <a class="deeplink" href="https://github.com/beadhive/beadhive/blob/main/docs/ADOPTION.md">Wiring the backup</a>
        </div>
      </li>
      <li class="rungrow">
        <span class="rungno"><svg viewBox="0 0 30 34" aria-hidden="true"><polygon points="15,2 28,9.5 28,24.5 15,32 2,24.5 2,9.5"/></svg><span>3</span></span>
        <div class="rungbody">
          <h3>Every tool pinned, so next month behaves like today</h3>
          <p><code>bh</code> doesn't work alone — it drives four other programs. This is where
          they get installed together and held at versions that match, instead of being whatever
          each machine happened to have. Take it in any order — before rung 2, after rung 4, or
          never.</p>
          <p class="rungcost"><b>What it costs:</b> a one-time install that asks for an
          administrator password, and a wait while it downloads. Not every machine can take it.</p>
          <a class="deeplink" href="https://github.com/beadhive/beadhive/blob/main/docs/ADOPTION.md">What gets pinned, and where it works</a>
        </div>
      </li>
      <li class="rungrow">
        <span class="rungno"><svg viewBox="0 0 30 34" aria-hidden="true"><polygon points="15,2 28,9.5 28,24.5 15,32 2,24.5 2,9.5"/></svg><span>4</span></span>
        <div class="rungbody">
          <h3>A machine that keeps working while you sleep</h3>
          <p>An always-on machine does the running; your laptop goes back to being where you
          decide things. You can still hand it work from anywhere, and read what it did.</p>
          <p class="rungcost"><b>What it costs:</b> rung 2 first — there's no way around that
          one — and a second machine to keep running. This is the newest ground here, and it's
          still settling.</p>
          <a class="deeplink" href="https://github.com/beadhive/beadhive/blob/main/docs/ADOPTION.md">What a second machine involves</a>
        </div>
      </li>
    </ol>
    <p class="step-closer">Most people never leave the first rung, and that is a finished
    posture rather than a stalled one. The ceiling is here so you can see it, not so you climb it.</p>
  </div>
</section>

<div class="band">
<section id="learn" class="step step--flip">
  <div class="wrap">
    <div class="eyebrow display"><span class="stepno">07</span><span>The quiet part</span></div>
    <div class="step-grid">
      <div class="step-text">
        <h2 class="display">You'll learn the process by watching it work</h2>
        <p>Every time the factory does something that looks like ceremony — records a decision,
        refuses a merge, writes up what an incident taught it — it says why. That knowledge is
        yours to keep, whatever you build next.</p>
      </div>
      <div class="step-side">
        <div class="sidecard herobar">
          <a class="btn btn-primary" href="https://github.com/beadhive/beadhive/blob/main/INSTALL.md">Full install guide</a>
          <a class="btn btn-ghost" href="/process/">See how the factory works</a>
        </div>
      </div>
    </div>
  </div>
</section>
</div>

</Layout>

<style>
  /* ---------- numbered path ----------
     The step number rides inside the existing eyebrow, so the hairline rule
     still trails it and the label keeps its small-caps voice. Numbers stay at
     the page's left edge on every step — the path reads top-to-bottom even
     while the content below alternates sides. */
  .stepno {
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--honey-strong);
    font-variant-numeric: tabular-nums;
  }

  /* Hero h2 used to balance-wrap after "The"; break at the sentence boundary
     instead. Below 640px the line is too short for the br — let text-wrap:
     balance handle it. */
  .herobr { display: none; }
  @media (min-width: 640px) {
    .herobr { display: inline; }
  }

  /* ---------- first-loop mini-ring ----------
     Stacked: a compact ring under the intro copy — the mental map for the six
     numbered steps that follow. ≥1024px: the intro becomes the same two-column
     shape as the step rows, ring on the right. */
  .miniloop { margin: 0; }
  .miniloop svg {
    display: block; width: 100%; max-width: 17.5rem; height: auto;
    margin: 26px auto 0;
  }
  .ml-cell { fill: var(--panel-2); stroke: var(--mark-line); stroke-width: 2; }
  .ml-cell.is-next { stroke: var(--honey); stroke-width: 2.4; }
  .ml-edge { stroke: var(--mark-line); stroke-width: 2; opacity: .7; }
  .ml-edge.is-closing { stroke: var(--honey); stroke-width: 2.6; opacity: 1; }
  .miniloop text { font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; }
  .ml-label { fill: var(--ink); font-size: 13px; font-weight: 600; }
  .ml-note  { fill: var(--honey-strong); font-size: 11px; font-weight: 600; }

  @media (min-width: 1024px) {
    .intro-grid {
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: 4.5rem;
      align-items: center;
      margin-top: 6px;
    }
    .intro-copy > p:last-child { margin-bottom: 0; }
    .miniloop svg { margin: 0 auto; max-width: 20rem; }
  }

  /* ---------- mobile-first: everything stacks ---------- */
  .step-side { margin-top: 18px; }
  .sidecard {
    background: var(--panel);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    padding: 20px 22px;
    box-shadow: var(--shadow);
  }
  /* The bare `.bullets` list has no global styling outside .featrow; give it
     the same hex-bullet voice here. */
  .sidecard .bullets {
    list-style: none;
    margin: 0;
    padding-left: 0;
    max-width: none;
  }
  /* NOT the .featrow grid-li treatment: these li contain <b> children, and a
     grid li promotes each child to its own grid item, shattering the line. */
  .sidecard .bullets li {
    position: relative;
    padding-left: 1.25rem;
    font-size: .93rem;
    line-height: 1.6;
    color: var(--ink-2);
    margin-bottom: 12px;
  }
  .sidecard .bullets li:last-child { margin-bottom: 0; }
  .sidecard .bullets li::before {
    content: "⬢";
    position: absolute;
    left: 0;
    top: .3em;
    color: var(--honey-strong);
    font-size: 10px;
    line-height: 1;
  }
  .sidecard.herobar { margin-top: 0; gap: 12px; }
  .sidecard.herobar .btn { flex: 1 1 auto; justify-content: center; }

  /* ---------- how far it goes: the four rungs ----------
     An <ol> because the ORDER is load-bearing — it matches docs/ADOPTION.md, so
     a reader who follows a link lands where they expect. The number is real
     content in a comb cell rather than a list marker, so it survives
